{
  "name": "furvet",
  "version": "0.1.0",
  "private": true,
  "description": "FurVet — AI assistant for the vet visit. PayPal AI Hackathon 2026 (sandbox only).",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types --env-interface CloudflareBindings --strict-vars=false",
    "typecheck": "npm run types && tsc --noEmit",
    "test": "bash scripts/checks.sh && vitest run",
    "db:migrate:local": "wrangler d1 migrations apply furvet --local",
    "db:migrate:remote": "wrangler d1 migrations apply furvet --remote"
  },
  "dependencies": {
    "hono": "4.13.16",
    "pdf-lib": "1.17.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.23.0",
    "@types/node": "^22.15.17",
    "typescript": "5.9.3",
    "vitest": "4.1.0",
    "wrangler": "4.157.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true,
    "workerd@1.20260815.1": true,
    "workerd@1.20261103.1": true
  }
}
